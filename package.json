{
  "name": "crewdeck",
  "version": "0.7.0",
  "description": "Your one-person company inside Claude desktop: SilverBullet notes, Backlog.md boards and Claude agents in one workspace.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "crewdeck": "./bin/crewdeck.mjs"
  },
  "scripts": {
    "crewdeck": "node src/cli.ts",
    "test": "node scripts/leak-scan.mjs && node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "leak-scan": "node scripts/leak-scan.mjs"
  },
  "dependencies": {
    "backlog.md": "1.55.3",
    "htm": "3.1.1",
    "playwright-core": "1.65.1",
    "preact": "10.29.8",
    "yaml": "^2.8.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pulkitnagpal/crewdeck.git"
  },
  "homepage": "https://github.com/pulkitnagpal/crewdeck#readme",
  "keywords": [
    "claude",
    "claude-code",
    "silverbullet",
    "backlog.md",
    "second-brain",
    "kanban",
    "agents",
    "local-first"
  ],
  "devDependencies": {
    "preact-render-to-string": "6.8.2"
  }
}
